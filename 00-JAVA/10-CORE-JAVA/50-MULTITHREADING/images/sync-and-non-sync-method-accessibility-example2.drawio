    <mxGraphModel dx="2224" dy="2643" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3QyqJY31oXpYx-3wBOSR-94" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Georgia;fontSize=15;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;ul&gt;&lt;li&gt;Synchronized static methods use the &lt;b&gt;class lock&lt;/b&gt; (&lt;i&gt;BankAccount.class&lt;/i&gt;). Only one thread can execute any static synchronized method of the same class at a time.&lt;/li&gt;&lt;li&gt;Synchronized instance methods use the &lt;b&gt;object lock&lt;/b&gt; (&lt;i&gt;account&lt;/i&gt;). Only one thread can execute any synchronized instance method on the same object at a time.&lt;/li&gt;&lt;li&gt;Non-synchronized static methods can be executed by multiple threads simultaneously (&lt;b&gt;no class lock&lt;/b&gt;).&lt;/li&gt;&lt;li&gt;Non-synchronized instance methods can be executed by multiple threads simultaneously (&lt;b&gt;no object lock&lt;/b&gt;).&lt;/li&gt;&lt;li&gt;Static synchronized methods and instance synchronized methods do not block each other because they use different locks (&lt;b&gt;class lock vs object lock&lt;/b&gt;).&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="160" width="1126.23" x="-13.12" y="1140" as="geometry" />
        </mxCell>
