        </mxCell>
        <mxCell id="s5e1" edge="1" parent="1" source="s5T1" style="endArrow=classic;html=1;rounded=0;strokeColor=#C00000;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#C00000;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=Georgia;" target="s5B" value="waits for&lt;br&gt;Database lock">
