        <mxCell id="s5e2" edge="1" parent="1" source="s5B" style="endArrow=classic;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#555555;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Georgia;" target="s5T2" value="held by">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e3" edge="1" parent="1" source="s5T2" style="endArrow=classic;html=1;rounded=0;strokeColor=#0033CC;strokeWidth=3;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontColor=#0033CC;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=Georgia;" target="s5D" value="waits for&lt;br&gt;Document lock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5e4" edge="1" parent="1" source="s5D" style="endArrow=classic;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontColor=#555555;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Georgia;" target="s5T1" value="held by">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5X" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC0000;dashed=1;strokeWidth=2;fontColor=#CC0000;fontSize=12;fontFamily=Georgia;" value="&lt;b&gt;&lt;u&gt;Circular Wait → Deadlock&lt;/u&gt;&lt;/b&gt;&lt;br&gt;(both threads are waiting forever)" vertex="1">
          <mxGeometry height="60" width="313" x="1262" y="780" as="geometry" />
        </mxCell>
        <mxCell id="tbl" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#82B366;spacingLeft=6;spacingTop=4;fontFamily=Georgia;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Important Lines Related to Deadlock&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px;margin-top:4px&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th align=&quot;left&quot;&gt;Line No.&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Code&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;What it does&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Document.java – 2&lt;/td&gt;&lt;td&gt;&lt;font&gt;public synchronized void process (...)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Thread 1 acquires Document lock.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Document.java – 8&lt;/td&gt;&lt;td&gt;&lt;font&gt;database.accessDocument();&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Thread 1 tries to acquire Database lock (can block).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Database.java – 2&lt;/td&gt;&lt;td&gt;&lt;font&gt;public synchronized void syncDocument (...)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Thread 2 acquires Database lock.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Database.java – 8&lt;/td&gt;&lt;td&gt;&lt;font&gt;document.accessDocument();&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Thread 2 tries to acquire Document lock (can block).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Document.java – 10&lt;/td&gt;&lt;td&gt;&lt;font&gt;public synchronized void accessDocument ()&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Requires Document lock (used by Thread 2).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Database.java – 10&lt;/td&gt;&lt;td&gt;&lt;font&gt;public synchronized void accessDocument ()&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Requires Database lock (used by Thread 1).&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="175" width="1000" x="20" y="875" as="geometry" />
        </mxCell>
        <mxCell id="kt" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;spacingLeft=6;spacingTop=4;fontFamily=Georgia;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Key Takeaways&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:18px;font-size:11px&quot;&gt;&lt;li&gt;Both threads acquire different locks in different order.&lt;/li&gt;&lt;li&gt;Thread 1: Document → Database&lt;/li&gt;&lt;li&gt;Thread 2: Database → Document&lt;/li&gt;&lt;li&gt;Each thread holds one lock and waits for the other (hold and wait).&lt;/li&gt;&lt;li&gt;Neither can proceed, so the program hangs (deadlock).&lt;/li&gt;&lt;li&gt;Thread.sleep(1000) is not the cause of deadlock; it just gives both threads time to acquire their respective first lock.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="175" width="496" x="1040" y="875" as="geometry" />
        </mxCell>
