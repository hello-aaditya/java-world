"font-size: 17px;"><span style="text-decoration-color: light-dark(rgb(244, 200, 45), rgb(106, 68, 0));">Hashtable</span> <span style="color: light-dark(rgb(0, 0, 192), rgb(213, 213, 255));">table</span> = <span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> <span style="text-decoration-color: light-dark(rgb(244, 200, 45), rgb(106, 68, 0));">Hashtable</span>();</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(5), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"A"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(2), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"B"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(6), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"C"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(15), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"D"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(23), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"E"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">table.put(<span style="color: light-dark(rgb(127, 0, 85), rgb(255, 180, 253)); font-weight: bold;">new</span> Temp(16), <span style="color: light-dark(rgb(42, 0, 255), rgb(226, 190, 255));">"F"</span>);</font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;"><br /></font></p><p style="margin: 0px;"><font style="font-size: 17px;">System.out.println(table)<u>;</u></font></p></div></div></div></div></div></foreignObject><image x="12" y="97.5" width="352" height="329.75" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ahX23O2Z84JwWH7nBUXR-5"><g transform="translate(0.5,0.5)"><rect x="605" y="10" width="170" height="30" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 168px; height: 1px; padding-top: 25px; margin-left: 606px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 15px; font-family: Georgia; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><font style="font-size: 18px;"><b>Initial Capacity = 11</b></font></div></div></div></foreignObject><image x="606" y="14.5" width="168" height="25.75" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="ahX23O2Z84JwWH7nBUXR-30"><g transform="translate(0.5,0.5)"><path d="M 690 773 L 690 7